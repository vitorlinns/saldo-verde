{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "mobile",
            "cwd": "mobile",
            "request": "launch",
            "type": "dart",
            "env": {
                "TMPDIR": "${workspaceFolder}/../tmp",
                "PUB_CACHE": "${workspaceFolder}/../.pub-cache",
                "GRADLE_OPTS": "-Djava.io.tmpdir=${workspaceFolder}/../tmp"
            }
        },
        {
            "name": "mobile (profile mode)",
            "cwd": "mobile",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "env": {
                "TMPDIR": "${workspaceFolder}/../tmp",
                "PUB_CACHE": "${workspaceFolder}/../.pub-cache",
                "GRADLE_OPTS": "-Djava.io.tmpdir=${workspaceFolder}/../tmp"
            }
        },
        {
            "name": "mobile (release mode)",
            "cwd": "mobile",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "env": {
                "TMPDIR": "${workspaceFolder}/../tmp",
                "PUB_CACHE": "${workspaceFolder}/../.pub-cache",
                "GRADLE_OPTS": "-Djava.io.tmpdir=${workspaceFolder}/../tmp"
            }
        }
    ]
}