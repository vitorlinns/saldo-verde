{
  "version": 2,
  "builds": [
    {
      "src": "site/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "app/frontend/package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "app/backend/api/**/[!_]*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/profile/([^/]+)",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/profile/[id].ts?id=$1"
    },
    {
      "src": "/health",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/health.ts"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/health.ts"
    },
    {
      "src": "/login",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/login.ts"
    },
    {
      "src": "/logout",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/logout.ts"
    },
    {
      "src": "/register",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/register.ts"
    },
    {
      "src": "/auth/login",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/auth/login.ts"
    },
    {
      "src": "/auth/logout",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/auth/logout.ts"
    },
    {
      "src": "/auth/refresh",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/auth/refresh.ts"
    },
    {
      "src": "/auth/me",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/auth/me.ts"
    },
    {
      "src": "/auth/sessions",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/auth/sessions.ts"
    },
    {
      "src": "/footer-text",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/footer-text.ts"
    },
    {
      "src": "/api/footer-text",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/footer-text.ts"
    },
    {
      "src": "/api/auth/login",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/auth/login.ts"
    },
    {
      "src": "/api/auth/logout",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/auth/logout.ts"
    },
    {
      "src": "/api/auth/refresh",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/auth/refresh.ts"
    },
    {
      "src": "/api/auth/me",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/auth/me.ts"
    },
    {
      "src": "/api/auth/sessions",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/auth/sessions.ts"
    },
    {
      "src": "/notifications/([^/]+)",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/notifications/[id].ts?id=$1"
    },
    {
      "src": "/notifications",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "dest": "/app/backend/api/notifications.ts"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "api.saldoverde.pro"
        }
      ],
      "status": 404,
      "dest": "/404"
    },
    {
      "src": "/api/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.saldoverde.pro"
        }
      ],
      "dest": "https://api.saldoverde.pro/$1"
    },
    {
      "src": "/assets/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.saldoverde.pro"
        }
      ],
      "dest": "/app/frontend/assets/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.saldoverde.pro"
        }
      ],
      "dest": "/app/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/site/$1"
    }
  ]
}
