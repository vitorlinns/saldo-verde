{
  "version": 2,
  "builds": [
    {
      "src": "site/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "app/frontend/package.json",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.saldoverde.pro"
        }
      ],
      "dest": "/app/frontend/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.saldoverde.pro"
        }
      ],
      "dest": "/app/frontend/dist/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/site/$1"
    }
  ]
}
